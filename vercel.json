{
  "version": 2,
  "buildCommand": "pip install -r project/backend/requirements.txt",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.11",
        "maxLambdaSize": "50mb",
        "includeFiles": "project/backend/**"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "env": {
    "ENVIRONMENT": "production",
    "DEBUG": "false",
    "PYTHONPATH": "/var/task/project/backend"
  }
}

