{
  "version": 2,
  "buildCommand": "cd project/backend && pip install -r requirements.txt",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.11",
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "project/frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "^/api(/.*)?$", "dest": "/api/index.py" },
    { "src": "^/$", "dest": "/project/frontend/index.html" },
    { "src": "^/(.*)$", "dest": "/project/frontend/$1" }
  ],
  "env": {
    "ENVIRONMENT": "production",
    "DEBUG": "false"
  }
}
